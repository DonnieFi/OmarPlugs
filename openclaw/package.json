{
  "name": "openclaw-plugin-lanarchy",
  "version": "0.5.0",
  "private": true,
  "description": "Optional native OpenClaw dashboard widget for the Lanarchy Omarchy plugin.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "test": "npm run build && node tests/contract.test.mjs",
    "smoke:live": "node smoke-live.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "lit": "3.3.3",
    "typebox": "1.3.30"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "openclaw": "2026.9.4",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./browser/index.ts",
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "bundledDist": false
    }
  }
}
