# Dotfiles / agent tooling — machine-local; never ship
.*
!.gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
venv/

# OS
Thumbs.db

# Secrets and credentials (never commit)
*.pem
*.key
*.p12
sand-secrets.json

# Beads / Dolt leftovers if not caught by .*
*.db
*.db-journal
*.db-wal
*.db-shm

# Homelab mesh — repo ships default inventory.json; local overrides stay untracked
homelab-mesh/inventory.local.json
homelab-mesh/inventory.json.bak
homelab-mesh/*.log
homelab-mesh/unifi-secrets.json
homelab-mesh/snapshot.json
homelab-mesh/history.json*
homelab-mesh/notify-state.json

# Scratch
*.tmp
*.swp
*~
